node_modules/
*.log
__pycache__/
.env
.env.*
!.env.example
# Local secrets: wrangler's dev vars, cloud credentials, private keys.
# Committing any of these to this PUBLIC repo publishes them.
.dev.vars
.dev.vars.*
serviceAccount*.json
*-key.json
*credentials*.json
*.p12
*.key
id_rsa*
dist/
dinescores_data.json
# Build output — Cloudflare Pages runs `npm run build` on every deploy,
# so built files are never committed (public/data.js IS committed: it is
# pipeline-generated data, not build output).
public/assets/
public/index.html
# SEO pages and files written by scripts/seo/build_seo.mjs and copied from static/
public/inspections/
public/about/
public/robots.txt
public/sitemap.xml
public/sitemap-pages.xml
public/llms.txt
public/og-image.png
public/google*.html

# Temporary agent worktrees created by Claude Code workflow runs
.claude/worktrees/

# scratch data.js written by scripts/backfill/absorb.sh before it is moved into place
public/.absorb_*
